# Environment Variables Template
# Category Association Discovery Across Clustered Transaction Segments

# Optional: Remote Python ML Microservice URL (e.g. deployed on Render/Railway)
# If left blank, the app uses its high-performance built-in Next.js ML engine
PYTHON_ML_SERVICE_URL=http://localhost:8000

# Optional: Database Connection (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/category_mining
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
